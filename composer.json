{
    "name": "vitexsoftware/digest-renderer",
    "description": "Markdown-first rendering library for accounting digest reports (HTML, PDF)",
    "type": "library",
    "keywords": ["digest", "markdown", "html", "pdf", "renderer", "reports"],
    "homepage": "https://github.com/VitexSoftware/DigestRenderer",
    "license": "MIT",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz",
            "homepage": "https://vitexsoftware.cz"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "fastvolt/markdown": "^0.2",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "VitexSoftware\\DigestRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VitexSoftware\\DigestRenderer\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "minimum-stability": "stable"
}